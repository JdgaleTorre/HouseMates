rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /houses/{houseId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Joining a house: append exactly the caller's own uid to memberIds,
      // nothing else about the house may change.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]);

      match /items/{itemId} {
        allow read, create, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberIds;
      }
    }

    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.houseId is string;
      allow update, delete: if false;
    }
  }
}
