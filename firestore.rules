rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /houses/{houseId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // memberIds/memberProfiles may only change via one of three shapes:
      // join (append caller's own uid), self-heal (refresh caller's own
      // profile entry, membership unchanged), or remove (an existing member
      // drops exactly one OTHER existing member). memberProfiles content
      // itself is not deeply validated -- same trust level items already
      // give createdByName.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberProfiles'])
        && (
          request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          || (request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds)
          || (request.auth.uid in resource.data.memberIds
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds))
        );

      match /items/{itemId} {
        allow read, create, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberIds;
      }

      match /sections/{sectionId} {
        allow read, create, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberIds;
      }
    }

    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.houseId is string;
      allow update, delete: if false;
    }
  }
}
